{
  "name": "sui-lens",
  "version": "0.0.1",
  "description": "CLI for inspecting Sui addresses, objects, transactions, and packages.",
  "keywords": [
    "node",
    "sui",
    "sui-lens",
    "typescript"
  ],
  "homepage": "https://github.com/danielmtavares/sui-lens#readme",
  "bugs": {
    "url": "https://github.com/danielmtavares/sui-lens/issues"
  },
  "license": "MIT",
  "author": "Daniel Tavares",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmtavares/sui-lens.git"
  },
  "bin": {
    "sui-lens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "tsup --config tsup.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test -- --run && pnpm build",
    "dev": "node --import tsx src/cli.ts",
    "format": "oxfmt \"*.{json,js,ts}\" \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \".github/**/*.{md,yml,yaml}\"",
    "format:check": "oxfmt --check \"*.{json,js,ts}\" \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \".github/**/*.{md,yml,yaml}\"",
    "lint": "oxlint . --import-plugin --promise-plugin --vitest-plugin --deny-warnings",
    "lint:fix": "oxlint . --import-plugin --promise-plugin --vitest-plugin --fix",
    "prepare": "git config core.hooksPath .githooks",
    "prepack": "pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mysten/sui": "2.17.0",
    "commander": "14.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.1.3"
}
